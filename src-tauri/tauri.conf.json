{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "myEPUB",
  "version": "0.1.0",
  "identifier": "com.localepub.reader",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "myEPUB",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "EPUB e-book",
        "mimeType": "application/epub+zip",
        "role": "Viewer",
        "rank": "Owner"
      }
    ]
  }
}
